mapscripts FileIsland_Entrance_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        call(Common_EventScript_SetupRivalGfxId)
    }
}

script FileIsland_Entrance_EventScript_Starter1 {
    lock
    playse(SE_PIN)
    setflag(FLAG_SYS_POKEMON_GET)
	applymovement(LOCALID_PLAYER, Common_Movement_ExclamationMark)
    delay(15)
    msgbox(format("From behind a tree, you see something moving."))
    special(ChooseStarter)
    waitstate
    applymovement(LOCALID_PLAYER, FileIsland_Entrance_Movement_Starter1)
    waitmovement(0)
    setvar(VAR_STARTER_TILE, 9)
    call(FileIsland_Entrance_EventScript_StarterTalk)
}

script FileIsland_Entrance_EventScript_Starter2 {
    lock
    playse(SE_PIN)
    setflag(FLAG_SYS_POKEMON_GET)
	applymovement(LOCALID_PLAYER, Common_Movement_ExclamationMark)
    delay(15)
    msgbox(format("From behind a tree, you see something moving."))
    special(ChooseStarter)
    waitstate
    setvar(VAR_STARTER_TILE, 0)
    call(FileIsland_Entrance_EventScript_StarterTalk)
}

