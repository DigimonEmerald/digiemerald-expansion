script FileIsland_Entrance_EventScript_Tree_Entrance {
    lock
    msgbox(format("You try touching the tree."))
    warp(MAP_INSIDE_TREE, 5, 8)
    release
}

script FileIsland_EventScript_RivalDecide {
    lock
    checkplayergender
    switch (var(VAR_FILEISLAND_ENTRANCE_STATE)) {
            case 5: call(FileIsland_EventScript_OtherGender)
            case 6: call(FileIsland_Entrance_EventScript_Rival)
        }
    release
}

script FileIsland_EventScript_OtherGender {
    lock
    checkplayergender
    switch (var(VAR_RESULT)) {
            case 0: call(FileIsland_Entrance_EventScript_Sora)
            case 1: call(FileIsland_Entrance_EventScript_Tai)
        }
    release
}

script FileIsland_Entrance_EventScript_Sora {
    lock
    faceplayer
    msgbox(format("{PLAYER} and Izzy: Sora!"))
    msgbox(format("Sora: That was a close one, huh?"))
    msgbox(format("{PLAYER}: What? That was no sweat!"))
    msgbox(format("???: Kuwagamon's sounds are far away now, Sora!"))
    msgbox(format("Sora: Great! Thanks Yokomon"))
    msgbox(format("Izzy: This looks like a plant, but is it..."))
    msgbox(format("...like one of them?"))
    addobject(25)
    applymovement(25, FileIsland_Entrance_Movement_TokomonApproach)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_ExclamationMark)
    applymovement(24, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, FileIsland_Entrance_Movement_IzzyLedge2)
    applymovement(24, FileIsland_Entrance_Movement_IzzyLedge2)
    waitmovement(0)
    msgbox(format("Izzy: There's another one!"))
    msgbox(format("???: Over here, T.K!"))
    msgbox(format("T.K: Tokomon!"))
    msgbox(format("Matt: T.K!"))
    addobject(26)
    addobject(27)
    applymovement(26, FileIsland_Entrance_Movement_TKApproach)
    delay(15)
    applymovement(27, FileIsland_Entrance_Movement_MattApproach)
    waitmovement(0)
    msgbox(format("{PLAYER}: Matt! You, too?"))
    msgbox(format("Matt: {PLAYER}! You're all here, too!"))
    msgbox(format("{PLAYER}: No, I mean that thing you're holding..."))
    msgbox(format("Matt: Huh? Oh, this is..."))
    msgbox(format("???: I'm Tsunomon."))
    msgbox(format("Joe: AHHHHHHHHHHHHHHHHHHHH"))
    addobject(28)
    applymovement(28, FileIsland_Entrance_Movement_JoeApproach)
    waitmovement(0)
    msgbox(format("Joe: Guys!"))
    msgbox(format("Joe: Help me!"))
    msgbox(format("Joe: S-Some weird thing is chasing me!"))
    msgbox(format("???: I'm not 'some weird thing'!"))
    msgbox(format("???: Call me Bukamon."))
    msgbox(format("Joe: AHHHHHHHHHHHHHHHHHHHH"))
    applymovement(28, Common_Movement_FaceUp)
    waitmovement(0)
    delay(10)
    applymovement(28, Common_Movement_FaceDown)
    waitmovement(0)
    delay(10)
    applymovement(28, Common_Movement_FaceUp)
    waitmovement(0)
    delay(10)
    applymovement(28, Common_Movement_FaceDown)
    waitmovement(0)
    delay(10)
    applymovement(28, Common_Movement_FaceUp)
    waitmovement(0)
    delay(40)
    applymovement(28, Common_Movement_FaceRight)
    waitmovement(0)
    delay(5)
    msgbox(format("Joe: Wha..."))
    msgbox(format("Joe: What the heck are these things?!"))
    msgbox(format("Digimon: We're Digital Monsters!"))
    msgbox(format("{PLAYER}: Digital Monsters?"))
    fadescreen(FADE_TO_BLACK)
    msgbox(format("Everyone quickly introduced themselves."))
    fadescreen(FADE_FROM_BLACK)
    msgbox(format("{PLAYER}: Right. I think that's everyone."))
    msgbox(format("Sora: Wait, wasn't there one more?"))
    msgbox(format("Izzy: Mimi! Mimi Tachikawa isn't here!"))
    msgbox(format("Joe: That's right! Mimi, the fourth grader!"))
    msgbox(format("Joe: I need to give her-"))
    msgbox(format("Mimi: AHHHHHHHHHHHHHHHHHHHHHHHHHHHHH"))
    msgbox(format("{PLAYER}: Quick, that sounded like it came from over here!"))
    setvar(VAR_FILEISLAND_ENTRANCE_STATE, 6)
    release
}

