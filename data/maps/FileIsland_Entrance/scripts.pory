script FileIsland_Entrance_EventScript_FirstIzzy {
    lock
    msgbox(format("Izzy: I wonder where we are."))
    release
}

script FileIsland_Entrance_EventScript_Partner {
    switch(var(VAR_STARTER_MON)) {
        case 0: msgbox(format("Koromon: It's amazing to see you finally!"))
        case 1: msgbox(format("Tanemon: It's amazing to see you finally!"))
        case 2: msgbox(format("Nyaromon: It's amazing to see you finally!"))
    }
    release
}

script FileIsland_Entrance_EventScript_Joe {
    lock
    msgbox(format("Joe: What are 'Digital Monsters' and why is that one so stuck to me?"))
    release
}

script FileIsland_Entrance_EventScript_Rival {
    lock
    checkplayergender
    switch (var(VAR_FILEISLAND_ENTRANCE_STATE)) {
            case 0: call(FileIsland_Entrance_EventScript_SoraTalk)
            case 1: call(FileIsland_Entrance_EventScript_TaiTalk)
        }
    release
}

script FileIsland_Entrance_EventScript_TaiTalk {
    lock
    msgbox(format("Tai: I hope Mimi is okay."))
    release
}

