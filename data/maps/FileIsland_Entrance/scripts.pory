        case 2: applymovement(4, FileIsland_Entrance_Movement_StarterApproachTrigger4)
    }
    waitmovement(0)
    call(FileIsland_Entrance_EventScript_StarterLedgeTalk)
}

script FileIsland_Entrance_EventScript_StarterLedgeTalk {
    switch(var(VAR_STARTER_MON)) {
        case 0: msgbox(format("Koromon: This is File Island!"))
        case 1: msgbox(format("Tanemon: This is File Island!"))
        case 2: msgbox(format("Nyaromon: This is File Island!"))
    }
    msgbox(format("Izzy: So you guys say..."))
    msgbox(format("{PLAYER}: We'll just have to check it out!"))
    releaseall
}

script FileIsland_Entrance_EventScript_KuwagamonLedge {
    lock
    addobject(8)
    applymovement(LOCALID_PLAYER, FileIsland_Entrance_Movement_Kuwagamon_Player_React)
    waitmovement(0)
    playse(SE_M_WING_ATTACK)
    delay(10)
    msgbox(format("SCREEEEEEEEEEEEE"))
    applymovement(8, FileIsland_Entrance_Movement_Kuwagamon_Fly)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_ExclamationMark)
    delay(15)
    msgbox(format("{PLAYER}: A red... stag beetle?"))
    msgbox(format("Motimon: Oh no! Thats Kuwagamon!"))
    msgbox(format("Motimon: He's a real savage Digimon!"))
    msgbox(format("Izzy: Watch out!"))
    delay(30)
    msgbox(format("Izzy: Kuwagamon is coming back!"))
    msgbox(format("Motimon: Run!"))
    setvar(VAR_FILEISLAND_ENTRANCE_STATE, 3)
    removeobject(8)
    removeobject(7)
    removeobject(6)
    removeobject(5)
    removeobject(4)
    removeobject(3)
    removeobject(2)
    removeobject(1)
    releaseall
}

script FileIsland_Entrance_EventScript_KuwagamonRunBlockUp {
    lock
    msgbox(format("This doesn't look like a good way to escape Kuwagamon!"))
    applymovement(LOCALID_PLAYER, FileIsland_Entrance_Movement_Walk_Down)
    waitmovement(0)
    releaseall
}

