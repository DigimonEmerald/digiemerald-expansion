script FileIsland_Entrance_EventScript_KuwagamonRunEnd1 {
    lock
    addobject(9)
    applymovement(9, FileIsland_Entrance_Movement_Izzy_Party )
    waitmovement(0)
    msgbox(format("Motimon: In here!"))
    applymovement(9, FileIsland_Entrance_Movement_Izzy_Tree1)
    waitmovement(0)
    removeobject(9)
    playse(SE_DOOR)
    delay(10)
    setvar(VAR_FILEISLAND_ENTRANCE_STATE, 4)
    releaseall
}

